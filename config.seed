# LibWrt 25.12 / Xiaomi AX3600 (stock layout) 编译配置种子
# 用法: cp config.seed .config && make defconfig
# 目标内核由所选源码基线决定（target/linux/generic/kernel-6.12 定义）：
#   v25.12.2  -> 6.12.103；VERSION_NUMBER=25.12.2；VERSION_REPO 指向 releases/25.12.2；feeds 锁 commit
#   25.12-nss -> 6.12.112 且会随分支更新；25.12-SNAPSHOT；VERSION_REPO 指向 releases/25.12-SNAPSHOT；feeds 滚动
# 设备定义: target/linux/qualcommax/image/ipq807x.mk -> Device/xiaomi_ax3600-stock
#
# 2026-11-09 修订（重要）：第一次编译产物只有
#   libwrt-qualcommax-ipq807x-aliyun_ap8220.manifest
# 即编成了阿里云 AP8220。原因：误用 CONFIG_TARGET_DEVICE_* 符号。
# 在 scripts/target-metadata.pl 里该符号属于 "Target Devices" 菜单，
# 整个菜单 depends on TARGET_MULTI_PROFILE；未启用 MULTI_PROFILE 时
# make defconfig 会静默丢弃它，Target Profile choice 于是回落到
# 字母序第一个设备 aliyun_ap8220。正确写法是单选 profile 符号：
#   CONFIG_TARGET_<target>_<subtarget>_DEVICE_<id>=y
# （参考公开 ax3600.config：CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y）
#
# 2026-11-09 18:38 修订：移除 WireGuard 三个包及 workflow 里的 with_wireguard 开关。
#
# 2026-11-09 18:48 修订：workflow 源码基线改为可选项（v25.12.2 固定发布版 /
# 25.12-nss 滚动分支），去掉产物名/注释里写死的 6.12.112，改为从源码读取内核版本。
# 19:24 按用户要求把默认改回 25.12-nss；需要同源时手动选 v25.12.2。
#
# 2026-11-09 19:40 定稿（用户要求）：固件【不编】任何代理 LuCI 应用与代理内核，
# 只把后续装代理必须用到的 kmod 一次性编进 squashfs。
# 理由：kmod 与自编译内核 vermagic 绑定，官方 kmods 源装不上（现网实测
# apk search -x kmod-tun / kmod-inet-diag / kmod-nft-tproxy 全部为空）；
# 而内核二进制和 LuCI 应用都是普通包，刷机后 apk add 即可直接装。
# 现网 25.12-SNAPSHOT apk 源实测可装：
#   sing-box 1.12.25-r1（full 版带 with_quic → VLESS + Hysteria2）
#   luci-app-homeproxy / luci-app-openclash / luci-compat / ruby-yaml / unzip
#   mihomo 没有 apk 包；OpenClash 的「插件设置 → 版本更新」页会自己下载内核，
#   不走「系统 → 软件包」页面，但若 GitHub raw 不通需切 CDN 或手动上传
# 刷机后一条命令：apk add sing-box luci-app-homeproxy
# 包清单对两种基线通用；切换基线时由 workflow 的 defconfig 断言复核。

##### Target（关键：必须选对机型）#####
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600-stock=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# make defconfig 会自动把 CONFIG_TARGET_PROFILE 设为
# "DEVICE_xiaomi_ax3600-stock"，不需要也不应该手写（无 prompt 的 string 符号）。

# 以下三行是第一次编译的错误写法，实际无效，故意注释留作教训：
# CONFIG_TARGET_ALL_PROFILES=n
# CONFIG_TARGET_PER_DEVICE_ROOTFS=n
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_xiaomi_ax3600-stock=y

##### 用户要求编进固件的软件（第一次编译 manifest 已验证全部生效）#####
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

##### 代理软件（2026-11-09 19:40 用户定稿：一律不编进固件）#####
# 不编 luci-app-openclash / luci-app-homeproxy / luci-app-nikki / sing-box /
# ruby / ruby-yaml / luci-compat / unzip / dnsmasq_full_nftset。
# 这些都是普通 apk 包，刷完机 apk add 即可；编进固件只会拉长编译、挤占分区。
# 唯一必须编进固件的是 kmod —— 见下面「附加 kmod」段。
#
# 官方 feeds 已核实（immortalwrt/packages 与 immortalwrt/luci 的 openwrt-25.12 分支）：
#   net/sing-box (1.12.25) / applications/luci-app-homeproxy /
#   applications/luci-app-openclash (0.48.002) / luci-compat / ruby-yaml / unzip
# sing-box full variant 的 GO_PKG_TAGS 含
#   with_quic, with_utls, with_gvisor, with_wireguard, with_clash_api
#   -> VLESS(Reality/Vision) 与 Hysteria2 都支持（with_quic 是 Hysteria2 必需）。
# luci-app-homeproxy 的 LUCI_DEPENDS:
#   +sing-box +firewall4 +kmod-nft-tproxy +ucode-mod-digest
#   firewall4 由 target 带入、kmod-nft-tproxy 已编、ucode-mod-digest 现网已装。
# luci-app-openclash 的 DEPENDS 里非 kmod 部分都能从 apk 源解析，但它是 Lua
#   老应用；内核由「插件设置 → 版本更新」页从
#   https://raw.githubusercontent.com/vernesong/OpenClash/core/master/meta/
#   下载预编译版，落到 /etc/openclash/core/clash_meta。国内不通时在
#   「GitHub 地址代理选项」切 jsdelivr CDN，或手动上传内核文件。
#
# 刷机后推荐：apk add sing-box luci-app-homeproxy
# 注意：当前是 DNS 旁路由，只有 DNS 查询经过本机，代理只能做显式代理
#   （客户端手动指向），不要开 TUN / 透明代理 / 内置 DNS 抢 :53，
#   否则会破坏 AGH :53 -> SmartDNS :6053 的链路。

##### LuCI 中文 / 基础工具（保持与现网一致）#####
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_block-mount=y

##### 附加 kmod（本固件唯一必须编入的代理相关部分；用户要求保留全套）#####
# 理由：kmod 与内核版本 + vermagic hash 绑定，自编译内核与官方 kmods 源
# hash 不同，在线 apk 装的 kmod 会加载失败；现网 distfeeds.list 也没有
# kmods 源，实测 apk search -x kmod-tun / kmod-inet-diag / kmod-nft-tproxy
# 全部为空。所以后续要装的 sing-box / HomeProxy / OpenClash 依赖的
# kmod 必须在这里一次性编进 squashfs，别指望刷机后补装。
# 对应关系：
#   kmod-tun / kmod-inet-diag / kmod-netlink-diag -> sing-box full 的 DEPENDS
#   kmod-nft-tproxy                              -> HomeProxy / OpenClash fw4
#   kmod-nft-socket                              -> PROCESS-NAME / socket 分流
# SNAPSHOT 滚动源只保留最近几个内核版本的 kmods；
# 之前 6.12.108 就是被「各镜像唯独缺这一版」坑到 kmod 装不上。
# 边界：只编网络类。AX3600 硬件没有 USB 口，USB / 存储 / 文件系统类
# kmod 一个都不编；target 的 DEVICE_PACKAGES 也显式排除了
# kmod-usb3 / kmod-usb-dwc3 / kmod-usb-dwc3-qcom / automount。
# 无线 ath11k 与 NSS 硬件加速由 target 默认带入，不重复写。
# 源码里不存在的包会被 make defconfig 静默丢弃，workflow 会打印 MISS 清单。

# -- 隧道 / VPN（kmod-tun 是 sing-box / OpenClash TUN 模式必需）--
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ovpn-backports=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-gre6=y
CONFIG_PACKAGE_kmod-vxlan=y
CONFIG_PACKAGE_kmod-geneve=y
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-l2tp-eth=y
CONFIG_PACKAGE_kmod-l2tp-ip=y
CONFIG_PACKAGE_kmod-pptp=y
CONFIG_PACKAGE_kmod-sit=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_kmod-iptunnel4=y
CONFIG_PACKAGE_kmod-iptunnel6=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y

# -- 虚拟网卡 / 桥接 / VLAN（单臂旁路由扩展用）--
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-bridge=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_kmod-ifb=y

# -- socket 诊断（iproute2 ss；kmod-inet-diag 是 sing-box / OpenClash 的依赖）--
# 自编译内核的 vermagic hash 与官方 kmods 源不同（55c8c5a7… vs 1a692294…），
# 在线 apk 装的 kmod 会加载失败，这类模块必须直接编进固件。
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-unix-diag=y
CONFIG_PACKAGE_kmod-packet-diag=y

# -- nftables 扩展（fw4 原生；kmod-nft-tproxy 是 HomeProxy / OpenClash 必需）--
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-bridge=y

# -- QoS / 队列 / 拥塞控制 --
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-fq_codel=y
CONFIG_PACKAGE_kmod-sched-htb=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

##### 不要动：以下由 target 默认包集自动带入 #####
# dnsmasq-full / firewall4 / odhcpd / hostapd-common / wpad-openssl /
# 全部 kmod-qca-nss-* / kmod-ath11k-* / ipq-wifi-xiaomi_ax3600
